GROQ_API_KEY=your-key-here
DEMO=0          # 1 wipes the shared default DB on start; per-visitor files are kept
MULTI_USER=1     # one private database per browser (cookie)
SEED_NEW=1       # give each new visitor sample data (set 0 for real use)
# On a host with a persistent disk, keep visitor data there:
# DATA_DIR=/data/visitors
# CHECKPOINT_DB=/data/checkpoints.db
